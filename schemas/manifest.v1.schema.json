{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "floodsaathi.manifest.v1",
  "type": "object",
  "required": [
    "id",
    "version",
    "size_bytes",
    "sha256",
    "files",
    "signature",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "min_ram_mb": {
      "type": "integer"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "licence": {
      "type": "string"
    },
    "eval_report_url": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "signature": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "changelog": {
      "type": "string"
    }
  }
}